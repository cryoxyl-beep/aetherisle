<Window x:Class="GrumphySwarm.App.Views.AgentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grumphy — Agent profile"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <!--
      A normal activatable window (NOT WS_EX_NOACTIVATE): text boxes need real
      keyboard focus, which the notch itself deliberately never takes.
    -->
    <Border Background="#0A0A0C"
            BorderBrush="#26262B"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12"
            Padding="20,14,20,18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" />
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,2,0,6">
                <TextBlock Text="Agent profile"
                           Style="{StaticResource CaptionStrongStyle}"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource MiniIconButtonStyle}"
                        x:Name="CloseButton"
                        Content="&#xE711;"
                        HorizontalAlignment="Right"
                        ToolTip="Close" />
            </Grid>
            <Border Background="{StaticResource HairlineBrush}" Height="1" Margin="0,0,0,4" />

            <TextBlock Text="NAME" Style="{StaticResource EditorLabelStyle}" />
            <TextBox x:Name="NameBox"
                     Style="{StaticResource EditorTextBoxStyle}"
                     MaxLength="32" />

            <TextBlock Text="TASK TYPE" Style="{StaticResource EditorLabelStyle}" />
            <ComboBox x:Name="TaskTypeBox"
                      Height="34"
                      Background="#131317"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource ModuleBorderBrush}"
                      BorderThickness="1"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id" />

            <TextBlock Text="TASK DESCRIPTION" Style="{StaticResource EditorLabelStyle}" />
            <TextBox x:Name="DescriptionBox"
                     Style="{StaticResource EditorTextBoxStyle}"
                     Height="86"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     MaxLength="400" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF6961"
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="10.5"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource EditorSecondaryButtonStyle}"
                        x:Name="CancelButton"
                        Content="Cancel" />
                <Button Style="{StaticResource EditorPrimaryButtonStyle}"
                        x:Name="SaveButton"
                        Content="Save"
                        Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
