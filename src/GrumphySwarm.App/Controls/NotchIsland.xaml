<UserControl x:Class="GrumphySwarm.App.Controls.NotchIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GrumphySwarm.App.Controls"
             xmlns:app="clr-namespace:GrumphySwarm.App"
             UseLayoutRounding="True">

    <!--
      Dynamic Island rendering: one capsule silhouette shared by the shadow
      layer, the black body and the content clip (see code-behind for the
      transition controller). Four content layers live inside the clip; exactly
      one is visible per transition target:

        CollapsedContent — pill: artwork · volume glyph · transient status ·
                           live audio bars · clock
        PanelContent     — Nook / Agents expanded panel (tabs + modules)
        MediaContent     — the media player expanded view
        BatteryContent   — earbud battery capsule
    -->
    <Grid x:Name="Root">
        <Path x:Name="ShadowPath" Fill="#000000">
            <Path.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="26"
                                  ShadowDepth="7"
                                  Direction="270"
                                  Opacity="0.55"
                                  RenderingBias="Performance" />
            </Path.Effect>
        </Path>
        <Path x:Name="BodyPath" Fill="#000000" />
        <Grid x:Name="ContentHost">

            <Rectangle Height="1"
                       Margin="24,0.5,24,0"
                       VerticalAlignment="Top"
                       Fill="{StaticResource TopHighlightBrush}"
                       IsHitTestVisible="False" />

            <!-- ========================== collapsed pill ========================== -->
            <Grid x:Name="CollapsedContent"
                  Width="264"
                  Height="40"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- left slot: allow-listed album art -->
                <Grid Grid.Column="0"
                      Width="26"
                      Height="26"
                      Margin="7,0,0,0"
                      VerticalAlignment="Center">
                    <Border Background="{StaticResource ChipBackgroundBrush}" CornerRadius="7">
                        <TextBlock Text="{x:Static app:StatusGlyphs.EmptyMedia}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="7">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding MediaArtwork, FallbackValue={x:Null}}"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Visibility>
                            <Binding Path="HasArtwork" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                        </Border.Visibility>
                    </Border>
                </Grid>

                <!-- center group: volume · battery · clock -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- volume: icon (red when muted) or live percent during changes -->
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding VolumeGlyph, FallbackValue=&#xE767;}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VolumeMuted}" Value="True">
                                            <Setter Property="Foreground" Value="#FF453A" />
                                        </DataTrigger>
                                        <!-- while a level change shows the live number, hide the icon -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding VolumeTransient}" Value="True" />
                                                <Condition Binding="{Binding VolumeMuted}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding VolumeTransientText, FallbackValue=''}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PillTimeStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VolumeTransient}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- system battery (hidden while the brightness transient shows) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrightnessTransient}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SystemBatterySupported}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <controls:SystemBatteryControl Width="22"
                                                       Height="11"
                                                       Percent="{Binding SystemBatteryPercent}"
                                                       IsCharging="{Binding SystemBatteryCharging}"
                                                       VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SystemBatteryText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <!-- brightness transient (replaces the battery slot briefly) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrightnessTransient}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding TransientGlyph}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TransientText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <!-- clock -->
                    <TextBlock Text="{Binding TimeText, FallbackValue='--:--'}"
                               Style="{StaticResource PillTimeStyle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <!-- live audio: radial lines around a circle (collapsed pill) -->
                <controls:AudioVisualizerControl Grid.Column="2"
                                                 Monitor="{Binding Spectrum}"
                                                 BarCount="16"
                                                 Mode="RadialLines"
                                                 Width="30"
                                                 Height="30"
                                                 Margin="0,0,9,0"
                                                 BarBrush="{StaticResource TextPrimaryBrush}"
                                                 VerticalAlignment="Center" />
            </Grid>

            <!-- ==================== expanded panel (Nook / Agents / Stats) ==================== -->
            <Grid x:Name="PanelContent"
                  Width="760"
                  Height="230"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: reference nav row on Nook · chip tabs on Agents/Stats -->
                <Grid Grid.Row="0" Margin="26,6,20,0">

                    <!-- Nook: four left icon buttons + lock/battery/bell/gear right -->
                    <Grid Visibility="{Binding IsNookTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="&#xE80F;"
                                    ToolTip="Nook · home"
                                    Command="{Binding ShowNookCommand}" />
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="&#xE821;"
                                    ToolTip="Agents"
                                    Command="{Binding ShowAgentsCommand}"
                                    Margin="10,0,0,0" />
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="&#xE787;"
                                    ToolTip="Calendar — shown in Nook"
                                    Command="{Binding ShowNookCommand}"
                                    Margin="10,0,0,0" />
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="&#xE753;"
                                    ToolTip="Weather — shown in Nook"
                                    Command="{Binding ShowNookCommand}"
                                    Margin="10,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="{Binding LockGlyph}"
                                    ToolTip="{Binding PinToolTip}"
                                    Command="{Binding TogglePinCommand}" />
                            <Button Style="{StaticResource BatteryPillStyle}"
                                    ToolTip="System stats"
                                    Command="{Binding ShowStatsCommand}"
                                    Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:SystemBatteryControl Width="20"
                                                                   Height="10"
                                                                   Percent="{Binding SystemBatteryPercent}"
                                                                   IsCharging="{Binding SystemBatteryCharging}"
                                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SystemBatteryText, FallbackValue=''}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="&#xEA8F;"
                                    ToolTip="No new notifications"
                                    Margin="10,0,0,0" />
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Content="&#xE713;"
                                    ToolTip="Settings — coming soon"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Agents / Stats: tab chips + transient + pin -->
                    <Grid Visibility="{Binding IsNookTab, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource TabChipStyle}"
                                         Content="Nook"
                                         IsChecked="{Binding IsNookTab, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource TabChipStyle}"
                                         Content="Agents"
                                         IsChecked="{Binding IsAgentsTab, Mode=TwoWay}"
                                         Margin="8,0,0,0" />
                            <RadioButton Style="{StaticResource TabChipStyle}"
                                         Content="Stats"
                                         IsChecked="{Binding IsStatsTab, Mode=TwoWay}"
                                         Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding TransientVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding TransientGlyph}"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TransientText}"
                                       Style="{StaticResource CaptionStrongStyle}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding TogglePinCommand}"
                                ToolTip="{Binding PinToolTip}"
                                Content="{Binding PinGlyph}"
                                HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <!-- ============ Nook tab (reference: nav row + 3 columns) ============ -->
                <Grid Grid.Row="1"
                      x:Name="NookTab"
                      Margin="26,2,26,12"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= left column: now playing ================= -->
                    <Grid Grid.Column="0" x:Name="MediaCard" Cursor="Hand">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- artwork with source-app badge -->
                        <Grid Grid.Column="0" Width="86" Height="86" VerticalAlignment="Center">
                            <Border Background="{StaticResource ChipBackgroundBrush}" CornerRadius="12">
                                <TextBlock Text="{x:Static app:StatusGlyphs.EmptyMedia}"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="20"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding MediaArtwork, FallbackValue={x:Null}}"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                                <Border.Visibility>
                                    <Binding Path="HasArtwork" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                </Border.Visibility>
                            </Border>
                            <Grid Width="42"
                                  Height="42"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,-7,-7"
                                  ToolTip="{Binding MediaSourceBadgeToolTip}"
                                  Visibility="{Binding MediaSourceBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="/Resources/applemusic.png"
                                       Width="38"
                                       Height="38"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsAppleMusicSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Image Source="/Resources/spotify.png"
                                       Width="38"
                                       Height="38"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSpotifySource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Background="{Binding MediaSourceBadgeBrush}" CornerRadius="15">
                                    <Image Source="{Binding MediaSourceAppIcon, FallbackValue={x:Null}}"
                                           Width="26"
                                           Height="26"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- title + artist + transport -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle, FallbackValue='Nothing playing'}"
                                       Style="{StaticResource MediaTitleStyle}"
                                       FontSize="13.5"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MediaArtistText, FallbackValue=''}"
                                       FontFamily="{StaticResource BodyFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button Style="{StaticResource BareTransportStyle}"
                                        Width="42"
                                        Height="30"
                                        Command="{Binding PreviousTrackCommand}"
                                        ToolTip="Previous">
                                    <Image Source="/Resources/icon-previous.png"
                                           Width="24"
                                           Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Button.Visibility>
                                        <Binding Path="CanPrevious" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Button.Visibility>
                                </Button>
                                <Button Style="{StaticResource BareTransportStyle}"
                                        Width="54"
                                        Height="36"
                                        Margin="14,0"
                                        Command="{Binding PlayPauseCommand}"
                                        ToolTip="Play / pause">
                                    <Button.Visibility>
                                        <Binding Path="CanPlayPause" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Button.Visibility>
                                    <Grid>
                                        <Image Source="/Resources/icon-play.png"
                                               Width="26"
                                               Height="29"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMediaPlaying}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image Source="/Resources/icon-pause.png"
                                               Width="26"
                                               Height="29"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource BareTransportStyle}"
                                        Width="42"
                                        Height="30"
                                        Command="{Binding NextTrackCommand}"
                                        ToolTip="Next">
                                    <Image Source="/Resources/icon-next.png"
                                           Width="24"
                                           Height="16"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Button.Visibility>
                                        <Binding Path="CanNext" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Button.Visibility>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Column="2" Width="1" Fill="{StaticResource HairlineBrush}" Margin="0,4" />

                    <!-- ================= center column: events (centered) ================= -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ShortDateText, FallbackValue=''}"
                                   FontFamily="{StaticResource PrimaryFontFamily}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="No events coming up"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Rectangle Grid.Column="6" Width="1" Fill="{StaticResource HairlineBrush}" Margin="0,4" />

                    <!-- ================= right column: weather (centered) ================= -->
                    <StackPanel Grid.Column="8"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <controls:WeatherIconControl Kind="{Binding WeatherIconKind, FallbackValue=Unknown}"
                                                         Width="34"
                                                         Height="34"
                                                         VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WeatherTempText, FallbackValue='—'}"
                                       Style="{StaticResource WeatherTempStyle}"
                                       VerticalAlignment="Center"
                                       Margin="8,2,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding WeatherConditionText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />

                        <TextBlock Text="{Binding WeatherCityText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStrongStyle}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />

                        <Grid Width="140" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource AccentOrangeBrush}">
                                        <TextBlock Text="&#xE74A;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="7.5"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="High"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding WeatherHighText, FallbackValue='—'}"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource AccentCyanBrush}">
                                        <TextBlock Text="&#xE74B;"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="7.5"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Low"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding WeatherLowText, FallbackValue='—'}"
                                           FontFamily="{StaticResource PrimaryFontFamily}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ======================= Agents tab ======================= -->
                <Grid Grid.Row="1"
                      x:Name="AgentsTab"
                      Margin="26,0,20,10"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Local profiles · agent runtime not connected yet"
                                   Style="{StaticResource MicroCaptionStyle}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="26"
                                Height="26"
                                FontSize="12"
                                Command="{Binding Agents.NewAgentCommand}"
                                ToolTip="Create agent"
                                Content="{x:Static app:StatusGlyphs.Add}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  Margin="0,8,0,0"
                                  ItemsSource="{Binding Agents.Profiles, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AgentRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{StaticResource SwarmGlyphGeometry}"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="12"
                                              Height="10"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource AgentNameStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TaskTypeId, Converter={StaticResource TaskTypeConverter}, FallbackValue=''}"
                                                       Style="{StaticResource MicroCaptionStyle}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                                    Command="{Binding DataContext.Agents.EditAgentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Edit"
                                                    Content="&#xE70F;" />
                                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                                    Command="{Binding DataContext.Agents.DeleteAgentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete"
                                                    Content="&#xE74D;"
                                                    Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Agents.HasProfiles, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <TextBlock Text="No agents yet"
                                   Style="{StaticResource AgentNameStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Create a local profile to get started"
                                   Style="{StaticResource MicroCaptionStyle}"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ======================= Stats tab (reference image 3) ======================= -->
                <Grid Grid.Row="1"
                      x:Name="StatsTab"
                      Margin="26,0,26,14"
                      VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <!-- left: ring gauges row + mini tiles row -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="108" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="46" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CPU gauge: ring centered, % inside, name beneath -->
                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Padding="8,7,8,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:BatteryRingControl Width="48"
                                                                 Height="48"
                                                                 HorizontalAlignment="Center"
                                                                 Percent="{Binding CpuFraction, Converter={StaticResource RoundedPercentConverter}}"
                                                                 FillBrush="{StaticResource AccentAmberBrush}" />
                                    <TextBlock Text="CPU"
                                               Style="{StaticResource StatNameStyle}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding CpuName, FallbackValue='CPU'}"
                                               Style="{StaticResource StatSubStyle}"
                                               HorizontalAlignment="Center"
                                               MaxWidth="130"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- GPU gauge -->
                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Padding="8,7,8,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:BatteryRingControl Width="48"
                                                                 Height="48"
                                                                 HorizontalAlignment="Center"
                                                                 Percent="{Binding GpuFraction, Converter={StaticResource RoundedPercentConverter}}"
                                                                 FillBrush="{StaticResource AccentPurpleBrush}" />
                                    <TextBlock Text="GPU"
                                               Style="{StaticResource StatNameStyle}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding GpuName, FallbackValue='GPU'}"
                                               Style="{StaticResource StatSubStyle}"
                                               HorizontalAlignment="Center"
                                               MaxWidth="130"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- RAM gauge -->
                            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" Padding="8,7,8,6">
                                <StackPanel HorizontalAlignment="Center">
                                    <controls:BatteryRingControl Width="48"
                                                                 Height="48"
                                                                 HorizontalAlignment="Center"
                                                                 Percent="{Binding RamFraction, Converter={StaticResource RoundedPercentConverter}}"
                                                                 FillBrush="{StaticResource AccentGreenBrush}" />
                                    <TextBlock Text="RAM"
                                               Style="{StaticResource StatNameStyle}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RamText, FallbackValue='—'}"
                                               Style="{StaticResource StatSubStyle}"
                                               HorizontalAlignment="Center"
                                               MaxWidth="130"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- mini tiles: disk / network / uptime -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" CornerRadius="12" Padding="10,7">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISK C:" Style="{StaticResource StatMiniLabelStyle}" />
                                    <TextBlock Text="{Binding DiskUsageText, FallbackValue='—'}" Style="{StaticResource StatMiniValueStyle}" FontSize="12" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" CornerRadius="12" Padding="10,7">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="NETWORK" Style="{StaticResource StatMiniLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFontFamily}" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NetDownText, FallbackValue=''}" Style="{StaticResource StatMiniValueStyle}" FontSize="9.5" Margin="2,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFontFamily}" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding NetUpText, FallbackValue=''}" Style="{StaticResource StatMiniValueStyle}" FontSize="9.5" Margin="2,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" CornerRadius="12" Padding="10,7">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="UP FOR" Style="{StaticResource StatMiniLabelStyle}" />
                                    <TextBlock Text="{Binding UptimeText, FallbackValue='—'}" Style="{StaticResource StatMiniValueStyle}" FontSize="12" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- right: top apps (full column height) -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="TOP APPS · CPU" Style="{StaticResource StatMiniLabelStyle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentGreenBrush}" />
                                    <TextBlock Text="live · 2s" Style="{StaticResource StatMiniLabelStyle}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TopApps, FallbackValue={x:Null}}" Margin="0,7,0,0" VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource ChipBackgroundBrush}"
                                                        CornerRadius="5"
                                                        Width="17"
                                                        Height="17">
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource AppInitialConverter}}"
                                                               Style="{StaticResource StatBadgeTextStyle}"
                                                               FontSize="9"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Style="{StaticResource StatMiniValueStyle}"
                                                           FontSize="10"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CpuPercent, StringFormat={}{0:0}%}"
                                                           Style="{StaticResource StatMiniValueStyle}"
                                                           FontSize="9.5"
                                                           VerticalAlignment="Center"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                            <Grid Grid.Row="1" Height="3" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToStarConverter}, Mode=OneWay}" />
                                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionRemainderConverter}, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="1.5,0,0,1.5" />
                                                <Border Grid.Column="1" Background="{StaticResource ChipBackgroundBrush}" CornerRadius="0,1.5,1.5,0" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================= media player view ======================= -->
            <!--
              Layout mirrors the reference: artwork left, title/artist stacked,
              waveform right; progress row with elapsed/remaining; transport
              row centered with the output icon at the right edge.
            -->
            <Grid x:Name="MediaContent"
                  Width="620"
                  Height="200"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- main row -->
                <Grid Grid.Row="0" Margin="26,20,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Top">
                        <Border Background="{StaticResource ChipBackgroundBrush}" CornerRadius="14">
                            <TextBlock Text="{x:Static app:StatusGlyphs.EmptyMedia}"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="24"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding MediaArtwork, FallbackValue={x:Null}}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Visibility>
                                <Binding Path="HasArtwork" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                            </Border.Visibility>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,6,10,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding MediaTitle, FallbackValue='Nothing playing'}"
                                   FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaSubtitle, FallbackValue=''}"
                                   FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <controls:AudioVisualizerControl Grid.Column="2"
                                                     Monitor="{Binding Spectrum}"
                                                     BarCount="9"
                                                     Width="40"
                                                     Height="30"
                                                     Margin="8,10,0,0"
                                                     BarBrush="{StaticResource TextPrimaryBrush}"
                                                     VerticalAlignment="Top" />
                </Grid>

                <!-- progress row -->
                <Grid Grid.Row="1" Margin="26,6,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ElapsedText, FallbackValue='0:00'}"
                               Style="{StaticResource MicroCaptionStyle}"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                    <Grid Grid.Column="1" Height="4" Margin="12,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PlaybackFraction, Converter={StaticResource FractionToStarConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding PlaybackFraction, Converter={StaticResource FractionRemainderConverter}, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F5F5F7" CornerRadius="2,0,0,2" />
                        <Border Grid.Column="1" Background="#3F3F42" CornerRadius="0,2,2,0" />
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="{Binding RemainingText, FallbackValue='-0:00'}"
                               Style="{StaticResource MicroCaptionStyle}"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>

                <!-- transport row: bare filled glyphs, no enclosures -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,20">
                    <Button Style="{StaticResource BareTransportStyle}"
                            Width="34"
                            Height="26"
                            IsEnabled="{Binding CanPrevious}"
                            Command="{Binding PreviousTrackCommand}"
                            ToolTip="Previous">
                        <Image Source="/Resources/icon-previous.png"
                               Width="18"
                               Height="12"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <Button Style="{StaticResource BareTransportStyle}"
                            Width="44"
                            Height="30"
                            Margin="20,0"
                            IsEnabled="{Binding CanPlayPause}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="Play / pause">
                        <Grid>
                            <Image Source="/Resources/icon-play.png"
                                   Width="21"
                                   Height="23"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaPlaying}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Image Source="/Resources/icon-pause.png"
                                   Width="21"
                                   Height="23"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource BareTransportStyle}"
                            Width="34"
                            Height="26"
                            IsEnabled="{Binding CanNext}"
                            Command="{Binding NextTrackCommand}"
                            ToolTip="Next">
                        <Image Source="/Resources/icon-next.png"
                               Width="18"
                               Height="12"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================= battery capsule ======================= -->
            <Grid x:Name="BatteryContent"
                  Width="340"
                  Height="84"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid Margin="24,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 3D earbuds artwork (user-supplied) -->
                    <Image Grid.Column="0"
                           Source="/Resources/earbuds3d.png"
                           Width="46"
                           Height="46"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryDeviceName, FallbackValue='Earbuds'}"
                                   Style="{StaticResource AgentNameStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding BatteryText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <controls:BatteryRingControl Grid.Column="2"
                                                 Width="38"
                                                 Height="38"
                                                 Percent="{Binding BatteryPercent}"
                                                 VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
