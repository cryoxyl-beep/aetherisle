<UserControl x:Class="GrumphySwarm.App.Controls.NotchIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GrumphySwarm.App.Controls"
             xmlns:app="clr-namespace:GrumphySwarm.App"
             UseLayoutRounding="True">

    <!--
      Dynamic Island rendering: one capsule silhouette shared by the shadow
      layer, the black body and the content clip (see code-behind for the
      transition controller). Four content layers live inside the clip; exactly
      one is visible per transition target:

        CollapsedContent — pill: artwork · volume glyph · transient status ·
                           live audio bars · clock
        PanelContent     — Nook / Agents expanded panel (tabs + modules)
        MediaContent     — the media player expanded view
        BatteryContent   — earbud battery capsule
    -->
    <Grid x:Name="Root">
        <Path x:Name="ShadowPath" Fill="#000000">
            <Path.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="26"
                                  ShadowDepth="7"
                                  Direction="270"
                                  Opacity="0.55"
                                  RenderingBias="Performance" />
            </Path.Effect>
        </Path>
        <Path x:Name="BodyPath" Fill="#000000" />
        <Grid x:Name="ContentHost">

            <Rectangle Height="1"
                       Margin="24,0.5,24,0"
                       VerticalAlignment="Top"
                       Fill="{StaticResource TopHighlightBrush}"
                       IsHitTestVisible="False" />

            <!-- ========================== collapsed pill ========================== -->
            <Grid x:Name="CollapsedContent"
                  Width="264"
                  Height="40"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- left slot: allow-listed album art -->
                <Grid Grid.Column="0"
                      Width="26"
                      Height="26"
                      Margin="7,0,0,0"
                      VerticalAlignment="Center">
                    <Border Background="{StaticResource ChipBackgroundBrush}" CornerRadius="7">
                        <TextBlock Text="{x:Static app:StatusGlyphs.EmptyMedia}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="7">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding MediaArtwork, FallbackValue={x:Null}}"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Visibility>
                            <Binding Path="HasArtwork" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                        </Border.Visibility>
                    </Border>
                </Grid>

                <!-- center group: volume · battery · clock -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- volume: icon (red when muted) or live percent during changes -->
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding VolumeGlyph, FallbackValue=&#xE767;}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VolumeMuted}" Value="True">
                                            <Setter Property="Foreground" Value="#FF453A" />
                                        </DataTrigger>
                                        <!-- while a level change shows the live number, hide the icon -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding VolumeTransient}" Value="True" />
                                                <Condition Binding="{Binding VolumeMuted}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding VolumeTransientText, FallbackValue=''}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PillTimeStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VolumeTransient}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- system battery (hidden while the brightness transient shows) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrightnessTransient}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SystemBatterySupported}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <controls:SystemBatteryControl Width="22"
                                                       Height="11"
                                                       Percent="{Binding SystemBatteryPercent}"
                                                       IsCharging="{Binding SystemBatteryCharging}"
                                                       VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SystemBatteryText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <!-- brightness transient (replaces the battery slot briefly) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrightnessTransient}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding TransientGlyph}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TransientText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <!-- clock -->
                    <TextBlock Text="{Binding TimeText, FallbackValue='--:--'}"
                               Style="{StaticResource PillTimeStyle}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <!-- next track shortcut (replaces the old radial visualizer here;
                     the full visualizer lives in the expanded player) -->
                <Button Grid.Column="2"
                        Style="{StaticResource TransportButtonStyle}"
                        Command="{Binding NextTrackCommand}"
                        ToolTip="Next track"
                        Content="{x:Static app:StatusGlyphs.Next}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Button.Visibility>
                        <Binding Path="CanNext" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                    </Button.Visibility>
                </Button>
            </Grid>

            <!-- ==================== expanded panel (Nook / Agents) ==================== -->
            <Grid x:Name="PanelContent"
                  Width="700"
                  Height="176"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: tabs · transient status · pin -->
                <Grid Grid.Row="0" Margin="26,6,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource TabChipStyle}"
                                     Content="Nook"
                                     IsChecked="{Binding IsNookTab, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource TabChipStyle}"
                                     Content="Agents"
                                     IsChecked="{Binding IsAgentsTab, Mode=TwoWay}"
                                     Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding TransientVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding TransientGlyph}"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TransientText}"
                                   Style="{StaticResource CaptionStrongStyle}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding TogglePinCommand}"
                            ToolTip="{Binding PinToolTip}"
                            Content="{Binding PinGlyph}"
                            HorizontalAlignment="Right" />
                </Grid>

                <!-- ======================= Nook tab ======================= -->
                <StackPanel Grid.Row="1"
                            x:Name="NookTab"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10">

                    <!-- Media card (live SMTC data) -->
                    <Border Style="{StaticResource ModuleCardStyle}" Width="270">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="46" Height="46" VerticalAlignment="Center">
                                <Border Background="{StaticResource ChipBackgroundBrush}" CornerRadius="10">
                                    <TextBlock Text="{x:Static app:StatusGlyphs.EmptyMedia}"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="15"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="10">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding MediaArtwork, FallbackValue={x:Null}}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                    <Border.Visibility>
                                        <Binding Path="HasArtwork" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Border.Visibility>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle, FallbackValue='Nothing playing'}"
                                           Style="{StaticResource MediaTitleStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaSubtitle, FallbackValue=''}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaStatusText, FallbackValue=''}"
                                           Style="{StaticResource MicroCaptionStyle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TransportButtonStyle}"
                                        Command="{Binding PreviousTrackCommand}"
                                        Content="{x:Static app:StatusGlyphs.Previous}">
                                    <Button.Visibility>
                                        <Binding Path="CanPrevious" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Button.Visibility>
                                </Button>
                                <Button Style="{StaticResource TransportButtonStyle}"
                                        Command="{Binding PlayPauseCommand}"
                                        Content="{Binding PlayPauseGlyph}"
                                        Margin="4,0,0,0">
                                    <Button.Visibility>
                                        <Binding Path="CanPlayPause" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Button.Visibility>
                                </Button>
                                <Button Style="{StaticResource TransportButtonStyle}"
                                        Command="{Binding NextTrackCommand}"
                                        Content="{x:Static app:StatusGlyphs.Next}"
                                        Margin="4,0,0,0">
                                    <Button.Visibility>
                                        <Binding Path="CanNext" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                                    </Button.Visibility>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Calendar card -->
                    <Border Style="{StaticResource ModuleCardStyle}" Width="224" Margin="12,0,0,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Calendar.MonthLabel, FallbackValue=''}"
                                       Style="{StaticResource MonthStyle}"
                                       VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <ItemsControl ItemsSource="{Binding Calendar.Days, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="24">
                                                <TextBlock Text="{Binding WeekdayLabel}"
                                                           Style="{StaticResource DayHeaderStyle}" />
                                                <Border x:Name="DayBadge"
                                                        CornerRadius="10"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock x:Name="DayText"
                                                               Text="{Binding DayNumber}"
                                                               Style="{StaticResource DayNumberStyle}" />
                                                </Border>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter TargetName="DayText" Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="DayBadge" Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                                    <Setter TargetName="DayText" Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Nothing for today"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Avatar / future desktop-pet slot -->
                    <Border Style="{StaticResource ReservedCardStyle}" Width="112" Margin="12,0,0,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="{StaticResource ChipBackgroundBrush}"
                                    CornerRadius="17"
                                    Width="34"
                                    Height="34">
                                <Path Data="{StaticResource SwarmGlyphGeometry}"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Width="16"
                                      Height="14"
                                      Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Pet"
                                       Style="{StaticResource ReservedTitleStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Milestone 3"
                                       Style="{StaticResource ReservedCaptionStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================= Agents tab ======================= -->
                <Grid Grid.Row="1"
                      x:Name="AgentsTab"
                      Margin="26,0,20,10"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Local profiles · agent runtime not connected yet"
                                   Style="{StaticResource MicroCaptionStyle}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="26"
                                Height="26"
                                FontSize="12"
                                Command="{Binding Agents.NewAgentCommand}"
                                ToolTip="Create agent"
                                Content="{x:Static app:StatusGlyphs.Add}"
                                HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  Margin="0,8,0,0"
                                  ItemsSource="{Binding Agents.Profiles, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AgentRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0"
                                              Data="{StaticResource SwarmGlyphGeometry}"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="12"
                                              Height="10"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource AgentNameStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TaskTypeId, Converter={StaticResource TaskTypeConverter}, FallbackValue=''}"
                                                       Style="{StaticResource MicroCaptionStyle}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                                    Command="{Binding DataContext.Agents.EditAgentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Edit"
                                                    Content="&#xE70F;" />
                                            <Button Style="{StaticResource MiniIconButtonStyle}"
                                                    Command="{Binding DataContext.Agents.DeleteAgentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete"
                                                    Content="&#xE74D;"
                                                    Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding Agents.HasProfiles, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <TextBlock Text="No agents yet"
                                   Style="{StaticResource AgentNameStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Create a local profile to get started"
                                   Style="{StaticResource MicroCaptionStyle}"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ======================= media player view ======================= -->
            <!--
              Layout mirrors the reference: artwork left, title/artist stacked,
              waveform right; progress row with elapsed/remaining; transport
              row centered with the output icon at the right edge.
            -->
            <Grid x:Name="MediaContent"
                  Width="560"
                  Height="190"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- main row -->
                <Grid Grid.Row="0" Margin="26,20,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Top">
                        <Border Background="{StaticResource ChipBackgroundBrush}" CornerRadius="14">
                            <TextBlock Text="{x:Static app:StatusGlyphs.EmptyMedia}"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="24"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding MediaArtwork, FallbackValue={x:Null}}"
                                            Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Visibility>
                                <Binding Path="HasArtwork" Converter="{StaticResource BooleanToVisibilityConverter}" FallbackValue="Collapsed" />
                            </Border.Visibility>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="16,6,10,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding MediaTitle, FallbackValue='Nothing playing'}"
                                   FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MediaSubtitle, FallbackValue=''}"
                                   FontFamily="{StaticResource BodyFontFamily}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <controls:AudioVisualizerControl Grid.Column="2"
                                                     Monitor="{Binding Spectrum}"
                                                     BarCount="9"
                                                     Width="40"
                                                     Height="30"
                                                     Margin="8,10,0,0"
                                                     BarBrush="{StaticResource TextPrimaryBrush}"
                                                     VerticalAlignment="Top" />
                </Grid>

                <!-- progress row -->
                <Grid Grid.Row="1" Margin="26,6,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ElapsedText, FallbackValue='0:00'}"
                               Style="{StaticResource MicroCaptionStyle}"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                    <Grid Grid.Column="1" Height="4" Margin="12,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PlaybackFraction, Converter={StaticResource FractionToStarConverter}, Mode=OneWay}" />
                            <ColumnDefinition Width="{Binding PlaybackFraction, Converter={StaticResource FractionRemainderConverter}, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F5F5F7" CornerRadius="2,0,0,2" />
                        <Border Grid.Column="1" Background="#3F3F42" CornerRadius="0,2,2,0" />
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="{Binding RemainingText, FallbackValue='-0:00'}"
                               Style="{StaticResource MicroCaptionStyle}"
                               VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>

                <!-- transport row -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,20">
                    <Button Style="{StaticResource TransportButtonStyle}"
                            Width="34"
                            Height="34"
                            FontSize="13"
                            IsEnabled="{Binding CanPrevious}"
                            Command="{Binding PreviousTrackCommand}"
                            Content="{x:Static app:StatusGlyphs.Previous}" />
                    <Button Style="{StaticResource TransportButtonStyle}"
                            Width="46"
                            Height="46"
                            FontSize="20"
                            Margin="18,0,0,0"
                            IsEnabled="{Binding CanPlayPause}"
                            Command="{Binding PlayPauseCommand}"
                            Content="{Binding PlayPauseGlyph}" />
                    <Button Style="{StaticResource TransportButtonStyle}"
                            Width="34"
                            Height="34"
                            FontSize="13"
                            Margin="18,0,0,0"
                            IsEnabled="{Binding CanNext}"
                            Command="{Binding NextTrackCommand}"
                            Content="{x:Static app:StatusGlyphs.Next}" />
                    <TextBlock Text="&#xEC15;"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="26,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ======================= battery capsule ======================= -->
            <Grid x:Name="BatteryContent"
                  Width="340"
                  Height="84"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid Margin="24,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- earbuds icon: two buds, AirPods-style -->
                    <Canvas Grid.Column="0"
                            Width="52"
                            Height="44"
                            VerticalAlignment="Center">
                        <Ellipse Canvas.Left="4" Canvas.Top="2" Width="13" Height="13" Fill="#F5F5F7" />
                        <Rectangle Canvas.Left="6.5" Canvas.Top="12" Width="8" Height="16" Fill="#F5F5F7" RadiusX="4" RadiusY="8" />
                        <Ellipse Canvas.Left="35" Canvas.Top="2" Width="13" Height="13" Fill="#F5F5F7" />
                        <Rectangle Canvas.Left="37.5" Canvas.Top="12" Width="8" Height="16" Fill="#F5F5F7" RadiusX="4" RadiusY="8" />
                    </Canvas>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BatteryDeviceName, FallbackValue='Earbuds'}"
                                   Style="{StaticResource AgentNameStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding BatteryText, FallbackValue=''}"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <controls:BatteryRingControl Grid.Column="2"
                                                 Width="38"
                                                 Height="38"
                                                 Percent="{Binding BatteryPercent}"
                                                 VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
